<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Deliberately standalone: no <parent>. This module is meant to be lifted into
         another repository (or deployed to your internal registry) as-is, so it must
         not inherit anything from the aggregator POM next to it. The aggregator lists
         it as a <module> for convenience only; Maven aggregation does not require
         inheritance. -->

    <groupId>com.example</groupId>
    <artifactId>selector-processor</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>selector-processor</name>
    <description>
        Annotation and annotation processor that generate recursive, null-safe selectors
        for API model objects.
    </description>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.12.2</junit.version>
    </properties>

    <!-- No third-party compile dependencies: the processor emits source using only the
         standard javax.annotation.processing / javax.lang.model APIs shipped with the JDK.
         Nothing extra to get through a security review, nothing on your runtime classpath. -->
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <!-- Never run this processor while compiling the processor itself. -->
                    <proc>none</proc>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>
</project>
